# What the library-vectors build runs, pinned. Sourced by bootstrap_runner.sh and
# build_library_vectors.sh; test_library_vectors_workflow.py checks the shapes.

# otzaria-semantic-search (the sidecar): embed-shard / warehouse-add / assemble / gates /
# release-files. The commit the plugin pins too, so the CLI, planner and validator run one sidecar.
SIDECAR_REPO=Otzaria/otzaria-semantic-search
SIDECAR_REV=3af594287f0dba1e858ac40937ea10615f923bba

# otzaria_search_engine (the plugin), with semantic-note projection and line
# text 4, which pins SIDECAR_REV:
# export_semantic_plan v2, which writes the plan from a release index through the sidecar's
# writers with the recipe the model's chunking_identity names (so one build plans every family),
# and validate_semantic_vectors, the gates a release passes on its index before it is
# published (G3 coverage, G4 resolution, G6 retrieval)
PLUGIN_REPO=Otzaria/otzaria_search_engine
PLUGIN_REV=ca822eb93da4e989d702079bcde0a3d3bc41390f

# The families in build order, <sidecar config dir>:<release prefix>[:<codec>[:<alias threshold>]],
# each published as <prefix>-<tag>; <codec> is the epoch a new base is assembled in (default: the
# sidecar's i8-sym-vec), and with rot192-i8i4 a short line shares a neighbour's vector at a cosine
# of <alias threshold> or more. Only the application's QA491 families are built automatically.
FAMILY_CONFIGS="config/models/meivin-qa491-onnx:vectors-qa491 config/models/meivin-qa491-windows-onnx:vectors-qa491-windows:rot192-i8i4:0.99"
FAMILY_MODEL_PROFILES="meivin-qa491-onnx:qa491 meivin-qa491-windows-onnx:qa491"
# The rot192-i8i4 rotations committed as rotation/<family>.bin, <family>=<SHA-256> each; a family
# not named here fits its own on the build machine (uploaded with the ledger backup, to commit here)
# A rotation is fitted to one passage package: a new PASSAGE_PACKAGE_CHECKSUM needs its own, or none.
ROTATIONS="meivin-qa491-windows-onnx=4408dd9c691b6ae957f2b0b25ad9fedb47d415838f6f0a5d5167020c4f7a785f"
# G6's recall floors, <family>=<recall@10>,<recall@50>, for a family held below the validator's
# own.
G6_FLOORS="meivin-qa491-windows-onnx=0.97,0.97"
# The families (by release prefix) mode auto also publishes a delta for, as <prefix>-delta-<tag>
DELTA_PREFIXES="vectors-qa491-windows"
# The QA491 packages; model_profiles.sh selects the opt-in Pardes pins separately.
# Families sharing this passage package share one warehouse.
PASSAGE_QUANTIZATION=fp32
PASSAGE_PACKAGE_CHECKSUM=5f80c47d3310a21fcc0c2f541fbb5732ba254555ef45afc2712cab63c8a33059
# The query package the application runs, the family's int8 one: the validator's G6 measures
# retrieval with it (fetched from the same mirror, at the same revision)
QUERY_PACKAGE_CHECKSUM=e90a67be02c077990c7bc2a6485f6872769ac2a71eb9779d25ceb1fcd97ac9b3
QUERY_GRAPH=query.int8.onnx
MODEL_REPO=otzaria/Meivin-Embed-QA491
MODEL_REVISION=a64ffc1bd7169c55c4b6624d68a7c339f5ac8d94
MODEL_GRAPH=document.fp32.onnx
MODEL_REMOTE_GRAPH=onnx/document.fp32.onnx

# The worker's Python environment (ROCm wheels come from the runner's wheel cache)
ROCM_WHEELS=/opt/otzaria-cache/wheels/rocm-7.2.1
TORCH_PIN=torch==2.9.1+rocm7.2.1.lw.gitff65f5bc
PY_PINS="numpy==2.5.3 onnx==1.23.1 onnxruntime==1.28.0 tokenizers==0.23.2"

# Embedding: a plan of fewer than CPU_EMBED_MAX texts runs on the CPU, through the sidecar's
# embed-shard in CPU_PROCESSES processes of CPU_THREADS ONNX Runtime threads (the reference: no
# parity certificate); a larger one on the GPU worker, in windows of EMBED_WINDOW records, whose
# certificate needs at least 959 plan texts. Measured on the build machine (i7-14700, 16 threads
# in WSL, 8,000 typical texts): 107 texts/s at 8 processes x 2 threads (46.5 at 1 x 16, 79 at
# 2 x 8, 100 at 4 x 4, 101 at 16 x 1), so the largest CPU plan takes about 8 minutes.
CPU_EMBED_MAX=50000
CPU_PROCESSES=8
CPU_THREADS=2
EMBED_WINDOW=1048576

# The free space a build needs on the state volume
MIN_FREE_GB=40

# Pardes remains available only by an explicit family request.
OPT_IN_FAMILY_CONFIGS="config/models/pardesqa491-windows-onnx:vectors-pardesqa491-windows"
FAMILY_MODEL_PROFILES="$FAMILY_MODEL_PROFILES pardesqa491-windows-onnx:pardesqa491"
